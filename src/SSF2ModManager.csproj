<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10 TFM enables WinRT SystemMediaTransportControls for media keys + now-playing metadata -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>SSF2M.ico</ApplicationIcon>
    <AssemblyTitle>SSF2 Mod Manager BETA *WORK IN PROGRESS*</AssemblyTitle>
    <Description>GameBanana Mod Manager for Super Smash Flash 2</Description>
    <Version>0.9.5</Version>
    <AssemblyVersion>0.9.5.0</AssemblyVersion>
    <FileVersion>0.9.5.0</FileVersion>
    <InformationalVersion>0.9.5</InformationalVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Dev builds go to bin\ — do NOT write into the release folder (that breaks PublishSingleFile). -->
    <OutputPath>$(MSBuildThisFileDirectory)bin\$(Configuration)\</OutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;tools\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Self-contained single-file publish (used by scripts/release/publish.ps1 / sync-release-exe.ps1).
       Content stays under runtime\ next to the exe (not embedded). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SharpCompress" Version="0.48.0" />
    <PackageReference Include="Markdig" Version="0.30.2" />
    <PackageReference Include="NLayer" Version="1.16.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="tools\FlaStepWizard\FlaStepWizard.csproj" />
  </ItemGroup>

  <!-- DestinationRelativePath remaps CopyToOutputDirectory into runtime\ (Link can drop nested binaries).
       SkipRuntimeSidecars=true: sync-dev.ps1 copies these into SSF2 Mod Manager\runtime\ itself (faster publish). -->
  <ItemGroup Condition="'$(SkipRuntimeSidecars)' != 'true'">
    <None Include="Languages\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <DestinationRelativePath>runtime\Languages\%(RecursiveDir)%(Filename)%(Extension)</DestinationRelativePath>
    </None>
    <None Include="News\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <DestinationRelativePath>runtime\News\%(RecursiveDir)%(Filename)%(Extension)</DestinationRelativePath>
    </None>
    <None Include="ffmpeg\**\*" Condition="Exists('ffmpeg\ffmpeg.exe') Or Exists('ffmpeg\bin\ffmpeg.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <DestinationRelativePath>runtime\ffmpeg\%(RecursiveDir)%(Filename)%(Extension)</DestinationRelativePath>
    </None>
  </ItemGroup>
  <ItemGroup Condition="'$(SkipRuntimeSidecars)' != 'true'">
    <Content Include="Themes\**\*.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <DestinationRelativePath>runtime\Themes\%(RecursiveDir)%(Filename)%(Extension)</DestinationRelativePath>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="SSF2M.png" />
    <Resource Include="Assets\Fonts\NimbusSansT-BlackCondensed.otf" />
    <!-- Stock BGM titles for the launcher mini player — no mappings export / SWF scan. -->
    <EmbeddedResource Include="Assets\music-library-stock.json" />
    <EmbeddedResource Include="Assets\build-file-lists.txt" />
    <EmbeddedResource Include="..\wiki\_static\credits.json">
      <LogicalName>SSF2ModManager.credits.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Include="native\ssfe_seal\ssfe_seal.dll" Condition="Exists('native\ssfe_seal\ssfe_seal.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>ssfe_seal.dll</TargetPath>
      <Link>ssfe_seal.dll</Link>
    </None>
  </ItemGroup>
  <ItemGroup Condition="'$(SkipRuntimeSidecars)' != 'true'">
    <None Include="Assets\music-library-stock.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <DestinationRelativePath>runtime\music-library-stock.json</DestinationRelativePath>
    </None>
  </ItemGroup>


</Project>
