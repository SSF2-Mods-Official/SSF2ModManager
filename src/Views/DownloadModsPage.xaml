<UserControl x:Class="SSF2ModManager.Views.DownloadModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Browse mods" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,8"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Events, music, tutorials, characters, stages, intros, and general mods."/>
            <DockPanel>
                <ComboBox x:Name="CmbCategory" Width="180" Margin="0,0,8,0"
                          Style="{StaticResource DarkComboBox}" SelectionChanged="Filter_Changed"/>
                <TextBox x:Name="TxtSearch" Style="{StaticResource ModernTextBox}"
                         TextChanged="Filter_Changed"/>
            </DockPanel>
            <TextBlock x:Name="TxtStatus" Margin="0,8,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
        <Button x:Name="BtnMore" DockPanel.Dock="Bottom" Content="Load more"
                HorizontalAlignment="Left" Margin="0,8,0,0"
                Style="{StaticResource ModernButton}" Padding="12,6" Click="BtnMore_Click"/>
        <ListBox x:Name="LstMods" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,6,0,6">
                        <Button Content="Download" DockPanel.Dock="Right"
                                Style="{StaticResource AccentButton}" Padding="12,6"
                                Click="BtnDownload_Click" Tag="{Binding}"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding CategoryLabel}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
