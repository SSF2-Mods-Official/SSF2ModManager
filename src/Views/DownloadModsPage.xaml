<UserControl x:Class="SSF2ModManager.Views.DownloadModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <DockPanel>
                <ComboBox x:Name="CmbCategory" Width="180" Margin="0,0,8,0"
                          Style="{StaticResource DarkComboBox}" SelectionChanged="Filter_Changed"/>
                <TextBox x:Name="TxtSearch" Style="{StaticResource ModernTextBox}"
                         TextChanged="Filter_Changed"/>
            </DockPanel>
            <CheckBox x:Name="ChkSemi" Margin="0,8,0,0"
                      Content="Show semi-supported mods (not .ssfe)"
                      IsChecked="True"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <CheckBox x:Name="ChkNineB" Margin="0,4,0,0"
                      Content="Show unsupported mods"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <TextBlock x:Name="TxtStatus" Margin="0,8,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
        <Button x:Name="BtnMore" DockPanel.Dock="Bottom" Content="Load more"
                HorizontalAlignment="Left" Margin="0,8,0,0"
                Style="{StaticResource ModernButton}" Padding="12,6" Click="BtnMore_Click"/>
        <Grid>
            <ListBox x:Name="LstMods" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,6,0,6">
                        <Border DockPanel.Dock="Left" Width="176" Height="99" Margin="0,0,12,0"
                                CornerRadius="4" ClipToBounds="True"
                                Background="{DynamicResource SurfaceBrush}">
                            <Image Source="{Binding PreviewUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Content="Download" Style="{StaticResource AccentButton}" Padding="12,6"
                                    Click="BtnDownload_Click" Tag="{Binding}" Visibility="{Binding DownloadVisibility}"/>
                            <Button Content="Page" Style="{StaticResource ModernButton}" Padding="12,4" Margin="0,6,0,0"
                                    Click="BtnPage_Click" Tag="{Binding}"/>
                        </StackPanel>
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                        Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                        Visibility="{Binding InstalledVisibility}">
                                    <TextBlock Text="Installed" FontSize="11" Foreground="White"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Byline}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Stats}" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Snippet}" FontSize="12" Margin="0,4,0,0"
                                       TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding FileSummary}" FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
            <TextBlock x:Name="TxtLoading" Text="&#xE895;" FontFamily="Segoe MDL2 Assets"
                       FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}" Visibility="Collapsed"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <RotateTransform x:Name="LoadingSpin"/>
                </TextBlock.RenderTransform>
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="LoadingSpin"
                                                 Storyboard.TargetProperty="Angle"
                                                 From="0" To="360" Duration="0:0:0.9"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>
        </Grid>
    </DockPanel>
</UserControl>
