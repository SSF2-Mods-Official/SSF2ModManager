<Window x:Class="SSF2ModManager.Views.AltEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit alt" Width="720" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TxtCharacter" Margin="0,0,0,10"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="Name" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtName" Margin="0,0,0,10"/>
            <TextBlock Text="Apply to" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton x:Name="RadAll" Content="All costumes" IsChecked="True" Margin="0,0,16,0"
                             Foreground="{DynamicResource TextPrimaryBrush}" Checked="Scope_Changed"/>
                <RadioButton x:Name="RadCostume" Content="Specific costume"
                             Foreground="{DynamicResource TextPrimaryBrush}" Checked="Scope_Changed"/>
            </StackPanel>
            <StackPanel x:Name="PanelCostume" Visibility="Collapsed" Margin="0,0,0,8">
                <TextBlock Text="Costume index (−1 = base)" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Pick in game…" Padding="12,6" Margin="8,0,0,0"
                            Click="BtnPick_Click"/>
                    <TextBox x:Name="TxtCostume" Text="-1"/>
                </DockPanel>
                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Jump still cycles this alt and selects the costume. Costume pick alone also applies the voice. Pick fills Name from the costume profile when available."/>
                <TextBlock x:Name="TxtPickStatus" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,4,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="Sounds"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TxtReplacedCount" DockPanel.Dock="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Replaced: 0"/>
                </DockPanel>
                <DockPanel Grid.Row="1" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Preview" Padding="10,6" Margin="0,0,6,0" Click="BtnPreview_Click"/>
                        <Button Content="Replace…" Padding="10,6" Margin="0,0,6,0" Click="BtnReplace_Click"/>
                        <Button Content="Restore" Padding="10,6" Margin="0,0,6,0" Click="BtnRestore_Click"/>
                        <Button Content="Restore all" Padding="10,6" Click="BtnRestoreAll_Click"/>
                    </StackPanel>
                    <ComboBox x:Name="CmbSounds" DisplayMemberPath="DisplayLabel"
                              SelectionChanged="CmbSounds_SelectionChanged"/>
                </DockPanel>
                <TextBlock x:Name="TxtSoundStatus" Grid.Row="2" FontSize="12" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Original" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtOrigInfo" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="—"/>
                            <Button Content="Play" Padding="10,6" Margin="0,10,0,0" HorizontalAlignment="Left"
                                    Click="BtnPlayOrig_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Current" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtCurrInfo" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="—"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Play" Padding="10,6" Margin="0,0,6,0" Click="BtnPlayCurr_Click"/>
                                <Button Content="Play both" Padding="10,6" Click="BtnPlayBoth_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource ModernButton}" Padding="14,8" Margin="0,0,8,0"
                    IsCancel="True" Click="BtnCancel_Click"/>
            <Button Content="Save" Style="{StaticResource AccentButton}" Padding="14,8"
                    IsDefault="True" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
