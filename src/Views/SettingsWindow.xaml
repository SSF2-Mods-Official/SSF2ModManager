<Window x:Class="SSF2ModManager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="520" Height="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <ComboBox x:Name="CmbLanguage" Visibility="Collapsed"
                      SelectionChanged="CmbLanguage_SelectionChanged"/>

            <TextBlock Text="Theme" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
            <ComboBox x:Name="CmbTheme" Style="{StaticResource DarkComboBox}" Margin="0,0,0,16"
                      SelectionChanged="CmbTheme_SelectionChanged"/>

            <TextBlock Text="Creator name" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
            <TextBlock Text="Written on events you make." FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>
            <TextBox x:Name="TxtEventCreator" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"
                     LostFocus="TxtEventCreator_LostFocus"/>

            <CheckBox x:Name="ChkUpdateAuto" Content="Update automatically"
                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"
                      Checked="ChkUpdateAuto_Changed" Unchecked="ChkUpdateAuto_Changed"/>

            <CheckBox x:Name="ChkExperimentalBranch" Content="Use experimental branch"
                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"
                      Tag="Receives GitHub prereleases for Mod Manager, SSF2 Shell, and Next2Flash."
                      Checked="ChkExperimentalBranch_Changed" Unchecked="ChkExperimentalBranch_Changed"/>
            <TextBlock Text="Receives prereleases for Mod Manager, SSF2 Shell, and Next2Flash."
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="24,0,0,10" TextWrapping="Wrap"/>

            <CheckBox x:Name="ChkPauseMusic" Content="Pause music when the game launches"
                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"
                      Tag="Stops the launcher player when SSF2 starts. Sync music clears the song so the game's music is the one that shows."
                      Checked="ChkPauseMusic_Changed" Unchecked="ChkPauseMusic_Changed"/>

            <CheckBox x:Name="ChkSyncMusic" Content="Sync music with the game"
                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"
                      Tag="While SSF2 is open, this player stays silent and follows the game, including menu changes. A song you pick shows the in-game banner when My Jukebox is closed."
                      Checked="ChkSyncMusic_Changed" Unchecked="ChkSyncMusic_Changed"/>

            <CheckBox x:Name="ChkClockAmPm" Content="Use AM/PM clock"
                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"
                      Tag="Off shows 24-hour time on the launcher sidebar."
                      Checked="ChkClockAmPm_Changed" Unchecked="ChkClockAmPm_Changed"/>

            <CheckBox x:Name="ChkBlurPaths" Content="Don't show file paths"
                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"
                      Tag="Hides the Shell and Next2Flash folder paths."
                      Checked="ChkBlurPaths_Changed" Unchecked="ChkBlurPaths_Changed"/>

            <TextBlock Text="SSF2 Shell folder" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
            <DockPanel Margin="0,0,0,16">
                <Button Content="Change" DockPanel.Dock="Right" Margin="8,0,0,0"
                        Style="{StaticResource ModernButton}" Padding="12,6" Click="BtnShellFolder_Click"/>
                <TextBox x:Name="TxtShellFolder" IsReadOnly="True" Style="{StaticResource ModernTextBox}"/>
            </DockPanel>

            <TextBlock Text="Data folder" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
            <CheckBox x:Name="ChkCompressData" Content="Compress data folder (.ssf)"
                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"
                      Tag="Compressed files are the zlib package the game uncompresses, named .ssf. Uncheck to write plain .swf files."
                      Checked="ChkCompressData_Changed" Unchecked="ChkCompressData_Changed"/>
            <TextBlock x:Name="TxtCompress" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

            <TextBlock Text="Debug editor" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
            <ComboBox x:Name="CmbIde" Style="{StaticResource DarkComboBox}" Margin="0,0,0,16"
                      SelectionChanged="CmbIde_SelectionChanged"/>

            <TextBlock Text="Next2Flash" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
            <TextBlock Text="A download is placed in the folder next to SSF2 Shell." FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>
            <DockPanel Margin="0,0,0,16">
                <Button Content="Change" DockPanel.Dock="Right" Margin="8,0,0,0"
                        Style="{StaticResource ModernButton}" Padding="12,6" Click="BtnNext2Flash_Click"/>
                <TextBox x:Name="TxtNext2Flash" IsReadOnly="True" Style="{StaticResource ModernTextBox}"/>
            </DockPanel>

            <TextBlock Text="Setup" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
            <TextBlock Text="Next2Flash, SSF2 Beta 1.4.0.1, building SSF2 Shell, and debugging." FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>
            <Button Content="Run setup" HorizontalAlignment="Left" Margin="0,0,0,16"
                    Style="{StaticResource ModernButton}" Padding="12,6" Click="BtnSetup_Click"/>

            <TextBlock Text="Menu background" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
            <TextBlock Text="Stage used as the menu backdrop. None keeps the stock menu." FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>
            <ComboBox x:Name="CmbMenuBg" Style="{StaticResource DarkComboBox}" Margin="0,0,0,8"
                      SelectionChanged="CmbMenuBg_SelectionChanged"/>
            <CheckBox x:Name="ChkManagerBgMatch" Content="Use as Mod Manager background"
                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"
                      Tag="When checked, the Mod Manager background uses this stage."
                      Checked="ChkManagerBgMatch_Changed" Unchecked="ChkManagerBgMatch_Changed"/>
            <TextBlock x:Name="LblManagerBg" Text="Mod Manager background" FontSize="13"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
            <TextBlock x:Name="LblManagerBgHint" Text="None is the SSF2 logo. A stage shows that backdrop with the logo peeking up."
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>
            <DockPanel x:Name="ManagerBgRow" LastChildFill="True">
                <Button x:Name="BtnManagerBgUpload" DockPanel.Dock="Right" Content="Upload" Margin="8,0,0,0"
                        Style="{StaticResource ModernButton}" Padding="12,6" Click="BtnManagerBgUpload_Click"
                        Tag="Pick a picture or video for the Mod Manager background. Animated files loop."/>
                <ComboBox x:Name="CmbManagerBg" Style="{StaticResource DarkComboBox}"
                          SelectionChanged="CmbManagerBg_SelectionChanged"/>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
