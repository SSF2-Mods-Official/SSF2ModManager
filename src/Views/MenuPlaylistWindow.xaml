<Window x:Class="SSF2ModManager.Views.MenuPlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Menu playlist"
        Width="520" Height="480"
        MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="Save" Style="{StaticResource ModernButton}" Padding="12,8" Margin="0,0,8,0"
                        Click="BtnSave_Click"/>
                <Button Content="Cancel" Style="{StaticResource ModernButton}" Padding="12,8"
                        Click="BtnCancel_Click"/>
            </WrapPanel>
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="These tracks play at random whenever the game starts menu music."/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button x:Name="BtnToggleEnabled" DockPanel.Dock="Right" Content="Disable"
                    Style="{StaticResource ModernButton}" Padding="12,6"
                    Margin="8,0,0,0" Click="BtnToggleEnabled_Click"/>
            <Button DockPanel.Dock="Right" Content="Add" Style="{StaticResource ModernButton}" Padding="12,6"
                    Margin="8,0,0,0" Click="BtnAdd_Click"/>
            <ComboBox x:Name="CmbTracks"/>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Stop" Style="{StaticResource ModernButton}" Padding="12,6"
                    Margin="8,0,0,0" Click="BtnStop_Click"/>
            <Button DockPanel.Dock="Right" Content="Preview" Style="{StaticResource ModernButton}" Padding="12,6"
                    Margin="8,0,0,0" Click="BtnPreview_Click"/>
            <Button Content="Remove" Style="{StaticResource ModernButton}" Padding="12,6" HorizontalAlignment="Left"
                    Click="BtnRemove_Click"/>
        </DockPanel>
        <ListBox x:Name="LstSongs" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
    </DockPanel>
</Window>
