<Window x:Class="SSF2ModManager.Views.ConfigureLaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure"
        Width="860" Height="720"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <DockPanel Margin="6,2,6,0" Background="{DynamicResource BackgroundBrush}">
        <DockPanel.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            </Style>
            <Style TargetType="ListBox">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            </Style>
            <BooleanToVisibilityConverter x:Key="BoolVis"/>
        </DockPanel.Resources>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,2" LastChildFill="True">
            <TextBlock x:Name="TxtStatus" DockPanel.Dock="Top" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button x:Name="BtnApply" Content="Apply to game" Style="{StaticResource ModernButton}" Padding="10,4" Margin="0,0,6,0"
                        Visibility="Collapsed" Click="BtnApply_Click"/>
                <Button x:Name="BtnGoto" Content="Goto menu" Style="{StaticResource ModernButton}" Padding="10,4" Margin="0,0,6,0"
                        Visibility="Collapsed" Click="BtnGotoMenu_Click"/>
                <Button Content="Launch" Style="{StaticResource ModernButton}" Padding="10,4" Margin="0,0,6,0"
                        Click="BtnLaunch_Click"/>
                <Button Content="Save &amp; Close" Style="{StaticResource ModernButton}" Padding="10,4"
                        Click="BtnSaveClose_Click"/>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="ChkUseEveryLaunch" Margin="0,0,10,0" Content="Remember"
                          Tag="Use the current setting each time the game launches"/>
                <CheckBox x:Name="ChkKeepOpen" Margin="0,0,10,0" Content="Keep open"
                          Tag="Keep this window open when launching"/>
                <CheckBox x:Name="ChkOpenFullscreen" Content="Fullscreen"
                          Tag="Open the game in fullscreen"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Starting menu" FontSize="14" Margin="0,0,0,6"/>
                <ComboBox x:Name="CmbMenu" Margin="0,0,0,8" SelectionChanged="CmbMenu_SelectionChanged"/>
                <StackPanel x:Name="BuildPanel" Margin="0,0,0,14" Visibility="Collapsed">
                    <TextBlock Text="Build Info" FontSize="14" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Point this at a downloaded SSF2 Shell build. The manager hashes SSF2.swf. That file carries the hashes of the original 1.4.0.1 files and the released shell files. A file that fails the hash should be treated with caution. A file that fails the expansion check should not be run."/>
                    <TextBlock x:Name="TxtBuildPath" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtBuildReport" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Change build" Style="{StaticResource ModernButton}" Padding="10,4" Margin="0,0,6,0" Click="BtnChangeBuild_Click"/>
                        <Button Content="Check again" Style="{StaticResource ModernButton}" Padding="10,4" Click="BtnCheckBuild_Click"/>
                    </StackPanel>
                </StackPanel>
                <CheckBox x:Name="ChkImmediate" Content="Load match immediately"
                          Margin="0,0,0,14" Visibility="Collapsed"/>

                <StackPanel x:Name="BootPanel" Margin="0,0,0,14">
                    <TextBlock Text="Boot intro" FontSize="14" Margin="0,0,0,6"/>
                    <TextBlock Text="Plays when Starting menu is Home." Margin="0,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="CmbBoot" Margin="0,0,0,8" SelectionChanged="CmbBoot_SelectionChanged"/>
                    <StackPanel x:Name="PoolPanel" Margin="0,0,0,8">
                        <TextBlock Text="Random pool" Margin="0,0,0,4"/>
                        <WrapPanel x:Name="PoolHost"/>
                    </StackPanel>
                    <TextBlock Text="Custom intros" Margin="0,8,0,4"/>
                    <TextBlock Text="Add and remove custom intros from Make Mods. They are stored in expansions/intros and listed here for the boot intro."
                               Margin="0,0,0,6" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ListBox x:Name="LstCustoms" Height="88" DisplayMemberPath="Label" IsEnabled="False"/>
                </StackPanel>

                <StackPanel x:Name="VaultPanel" Margin="0,0,0,14">
                    <TextBlock Text="Vault" FontSize="14" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbVaultAction" Margin="0,0,0,8" SelectionChanged="CmbVaultAction_SelectionChanged"/>
                    <StackPanel x:Name="VaultIntroPanel">
                        <TextBlock Text="Vault intro" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbVaultIntro" Margin="0,0,0,8"/>
                    </StackPanel>
                    <StackPanel x:Name="VaultCharPanel">
                        <TextBlock Text="Palette character" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbPalette"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="EventPanel" Margin="0,0,0,14" Visibility="Collapsed">
                    <TextBlock Text="Event" FontSize="14" Margin="0,0,0,6"/>
                    <TextBlock Text="Opens this event. Events that let you pick a fighter use that menu. For the rest, Override character replaces the scripted fighter."
                               Margin="0,0,0,6" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="CmbEvent" Margin="0,0,0,8" SelectionChanged="CmbEvent_SelectionChanged"/>
                    <TextBlock x:Name="TxtEventChoose" Text="This event lets you choose a character in-game."
                               Margin="0,0,0,6" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                    <StackPanel x:Name="EventOverridePanel">
                        <CheckBox x:Name="ChkEventOverride" Content="Override character" Margin="0,0,0,6"
                                  Checked="ChkEventOverride_Changed" Unchecked="ChkEventOverride_Changed"/>
                        <TextBlock Text="Character" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbEventChar"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="MatchPanel">
                    <TextBlock Text="Match" FontSize="14" Margin="0,0,0,6"/>

                    <StackPanel x:Name="StagePanel" Margin="0,0,0,8">
                        <TextBlock Text="Stage"/>
                        <ComboBox x:Name="CmbStage"/>
                    </StackPanel>

                    <StackPanel x:Name="ModePanel" Margin="0,0,0,8">
                        <TextBlock x:Name="TxtMode" Text="Mode"/>
                        <ComboBox x:Name="CmbMode"/>
                    </StackPanel>

                    <StackPanel x:Name="SandbagPanel" Margin="0,0,0,8" Visibility="Collapsed">
                        <CheckBox x:Name="ChkSandbag" Content="Override sandbag character" Margin="0,0,0,6"
                                  Checked="ChkSandbag_Changed" Unchecked="ChkSandbag_Changed"/>
                        <TextBlock Text="Sandbag character" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbSandbag"/>
                    </StackPanel>

                    <StackPanel x:Name="DifficultyPanel" Margin="0,0,0,8">
                        <TextBlock Text="Difficulty"/>
                        <ComboBox x:Name="CmbDifficulty"/>
                    </StackPanel>

                    <WrapPanel x:Name="RulesPanel" Margin="0,0,0,8">
                        <CheckBox x:Name="ChkHazards" Content="Hazards" Margin="0,0,16,6"/>
                        <CheckBox x:Name="ChkUsingTime" Content="Time" Margin="0,0,8,6"/>
                        <TextBox x:Name="TxtTime" Width="48" Margin="0,0,16,6" VerticalContentAlignment="Center"/>
                        <CheckBox x:Name="ChkUsingLives" Content="Stock" Margin="0,0,8,6"/>
                        <TextBlock x:Name="TxtLivesCaption" Text="Lives" VerticalAlignment="Center" Margin="0,0,6,6"/>
                        <TextBox x:Name="TxtLives" Width="48" Margin="0,0,16,6" VerticalContentAlignment="Center"/>
                        <TextBlock x:Name="TxtScoreCaption" Text="Score limit" VerticalAlignment="Center" Margin="0,0,6,6"/>
                        <TextBox x:Name="TxtScore" Width="48" Margin="0,0,0,6" VerticalContentAlignment="Center"/>
                    </WrapPanel>

                    <StackPanel x:Name="SpecialPanel" Margin="0,0,0,10">
                        <TextBlock Text="Special Smash" Margin="0,0,0,4"/>
                        <WrapPanel x:Name="SpecialHost"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtPlayers" Text="Players" FontSize="14" Margin="0,0,0,6"/>
                    <Grid x:Name="PlayerHeader">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Character" Margin="0,0,6,4"/>
                        <TextBlock x:Name="TxtHumanHeader" Grid.Column="2" Text="Human"/>
                        <TextBlock x:Name="TxtCpuHeader" Grid.Column="3" Text="CPU"/>
                        <TextBlock x:Name="TxtTeamHeader" Grid.Column="4" Text="Team"/>
                        <TextBlock x:Name="TxtTagHeader" Grid.Column="5" Text="Tag"/>
                    </Grid>
                    <ItemsControl x:Name="PlayerRows" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6" Visibility="{Binding RowVisible, Converter={StaticResource BoolVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Slot}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" Margin="0,0,6,0"
                                              ItemsSource="{Binding Characters}"
                                              SelectedItem="{Binding Character, UpdateSourceTrigger=PropertyChanged}"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding Human}" VerticalAlignment="Center"
                                              Visibility="{Binding ShowHuman, Converter={StaticResource BoolVis}}"/>
                                    <TextBox Grid.Column="3" Width="40" HorizontalAlignment="Left"
                                             Visibility="{Binding ShowCpu, Converter={StaticResource BoolVis}}"
                                             Text="{Binding Level, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="4" Width="40" HorizontalAlignment="Left"
                                             Visibility="{Binding ShowTeam, Converter={StaticResource BoolVis}}"
                                             Text="{Binding Team, UpdateSourceTrigger=PropertyChanged}"/>
                                    <ComboBox Grid.Column="5"
                                              ItemsSource="{Binding TagChoices}"
                                              SelectedItem="{Binding TagSelection, UpdateSourceTrigger=PropertyChanged}"
                                              Visibility="{Binding ShowTag, Converter={StaticResource BoolVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="MusicPanel" Visibility="Collapsed" Margin="0">
                    <TextBlock Text="Change Music" FontSize="14" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Set to default" Style="{StaticResource ModernButton}"
                                Padding="10,4" Margin="8,0,0,0" Click="BtnDefaultInGame_Click"/>
                        <TextBlock x:Name="TxtNowPlaying" Text="Current in-game music: —"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Manage playlist" Style="{StaticResource ModernButton}"
                                Padding="10,4" Margin="8,0,0,0" Click="BtnManagePlaylist_Click"/>
                        <Button DockPanel.Dock="Right" Content="Set to default" Style="{StaticResource ModernButton}"
                                Padding="10,4" Click="BtnDefaultMenu_Click"/>
                        <TextBlock x:Name="TxtMenuMusic" Text="Current menu music: —"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </DockPanel>
                    <ComboBox x:Name="CmbMusic" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkMusicOnLaunch" Content="Use this music when launching game" Margin="0,0,0,4"/>
                    <CheckBox x:Name="ChkMusicEverywhere" Content="Use this music everywhere" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button Content="Play" Style="{StaticResource ModernButton}" Padding="12,6" Margin="0,0,8,6"
                                Click="BtnPlayMusic_Click"/>
                        <Button Content="Stop" Style="{StaticResource ModernButton}" Padding="12,6" Margin="0,0,8,6"
                                Click="BtnStopMusic_Click"/>
                        <Button Content="Update in-game music" Style="{StaticResource ModernButton}" Padding="12,6" Margin="0,0,8,6"
                                Click="BtnUpdateMusic_Click"/>
                        <Button Content="Use as menu music" Style="{StaticResource ModernButton}" Padding="12,6" Margin="0,0,0,6"
                                Click="BtnMenuMusic_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="TxtMusicStatus" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
