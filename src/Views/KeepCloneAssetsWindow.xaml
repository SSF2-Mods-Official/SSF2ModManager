<Window x:Class="SSF2ModManager.Views.KeepCloneAssetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keep using clone's assets" Width="560" Height="420"
        MinWidth="440" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="IntroText" Text="These files are clones. Check the ones that should keep the original character's stock, costumes, and Classic / All-Star art."
                   TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
        <DockPanel Grid.Row="1" LastChildFill="True">
            <CheckBox x:Name="ChkAll" DockPanel.Dock="Top" Content="Check all" Margin="0,0,0,8"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      Checked="ChkAll_Changed" Unchecked="ChkAll_Changed"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ListHost"/>
            </ScrollViewer>
        </DockPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Import" Style="{StaticResource AccentButton}" Padding="14,8" Margin="0,0,8,0"
                    IsDefault="True" Click="BtnImport_Click"/>
            <Button Content="Cancel" Style="{StaticResource ModernButton}" Padding="14,8"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
