<UserControl x:Class="SSF2ModManager.Views.CreditsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
        <StackPanel>
            <TextBlock Text="Credits" FontSize="20"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
            <TextBlock x:Name="TxtGeneral" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
            <TextBlock Text="Downloaded mods" FontSize="16"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
            <TextBlock x:Name="TxtEmpty" Text="No downloaded mods yet."
                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
            <TextBlock x:Name="TxtMods" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
