<Window x:Class="SSF2ModManager.Views.ManageModsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Mods"
        Width="920" Height="760"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <DockPanel Margin="16" Background="{DynamicResource BackgroundBrush}">
        <DockPanel.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                <Setter Property="MinHeight" Value="28"/>
            </Style>
        </DockPanel.Resources>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource ModernButton}"
                    Padding="12,8" Click="BtnClose_Click"/>
            <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SectionsHost"/>
        </ScrollViewer>
    </DockPanel>
</Window>
