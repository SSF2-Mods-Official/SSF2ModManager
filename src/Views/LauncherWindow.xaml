<Window x:Class="SSF2ModManager.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:SSF2ModManager.Services"
        Title="{x:Static svc:AppInfo.ProductName}"
        Width="640" Height="360"
        MinWidth="640" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        ResizeMode="CanMinimize"
        Background="{DynamicResource BackgroundBrush}"
        PreviewKeyDown="Shell_PreviewKeyDown"
        PreviewMouseDown="Shell_PreviewMouseDown">
    <Window.Resources>
        <Style x:Key="LauncherPrimary" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="LauncherGhost" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Compact transport — tiny, no LauncherGhost padding. -->
        <Style x:Key="LauncherPlayerBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Thin accent seek track (sits on top of the glass player). -->
        <Style x:Key="LauncherSeekSlider" TargetType="Slider">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1000"/>
            <Setter Property="IsMoveToPointEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="3" CornerRadius="1.5" Background="{DynamicResource TextSecondaryBrush}" Opacity="0.45"
                                    VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" IsHitTestVisible="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" CornerRadius="1.5"
                                                        Background="{DynamicResource AccentBrush}"
                                                        VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="10" Height="10">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource AccentBrush}"
                                                         Stroke="#CCFFFFFF"
                                                         StrokeThickness="1.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" IsHitTestVisible="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Vertical volume in the speaker popup. -->
        <Style x:Key="LauncherVolumeSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Height" Value="88"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid HorizontalAlignment="Center">
                            <Border Width="3" CornerRadius="1.5" Background="{DynamicResource TextSecondaryBrush}" Opacity="0.45"
                                    HorizontalAlignment="Center"/>
                            <Track x:Name="PART_Track" Orientation="Vertical">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" IsHitTestVisible="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Width="3" CornerRadius="1.5"
                                                        Background="{DynamicResource AccentBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource AccentBrush}"
                                                         Stroke="#CCFFFFFF"
                                                         StrokeThickness="1.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" IsHitTestVisible="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Flat colored home tile. -->
        <Style x:Key="SmashTile" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="fill" Background="{TemplateBinding Background}" Opacity="0.5" CornerRadius="8"/>
                            <Border x:Name="shade" Background="#99000000" CornerRadius="8" IsHitTestVisible="False"/>
                            <Border x:Name="edge" BorderBrush="{TemplateBinding Background}" BorderThickness="2" CornerRadius="8" Background="Transparent">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <ContentPresenter.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="1.2" ShadowDepth="0" Opacity="1"/>
                                    </ContentPresenter.Effect>
                                </ContentPresenter>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fill" Property="Opacity" Value="1"/>
                                <Setter TargetName="shade" Property="Opacity" Value="0"/>
                                <Setter TargetName="edge" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmashRailBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#44FFFFFF"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LauncherSongPick" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" StaysOpen="False"
                                   AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        MinWidth="220" MaxHeight="280" CornerRadius="6">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid PreviewMouseMove="Shell_PreviewMouseMove">
        <Grid x:Name="HomeView">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="SidebarColumn" Width="52"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Grid.Column="0">
            <MediaElement x:Name="VidLauncherStage" Stretch="UniformToFill" Visibility="Collapsed"
                          LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True"
                          IsMuted="True" Volume="0"
                          MediaEnded="VidLauncherStage_Ended" MediaFailed="VidLauncherStage_Failed"/>
            <Image x:Name="ImgLauncherStage" Stretch="UniformToFill" Visibility="Collapsed"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="BannerScale" ScaleX="1.08" ScaleY="1.08"/>
                        <TranslateTransform x:Name="BannerShift"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
            <Grid x:Name="HomeTiles" Margin="6,6,4,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="72"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="PlayerCard" Grid.Row="0" Margin="3,3,3,0"
                                CornerRadius="8" BorderThickness="1" Padding="8,4"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                SizeChanged="RoundClip_SizeChanged">
                            <Grid>
                                <Canvas x:Name="LauncherMiniVisualizer" Opacity="0.4" IsHitTestVisible="False"/>
                                <Grid Margin="2,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,1">
                                        <TextBlock x:Name="TxtLauncherMiniTime" DockPanel.Dock="Left" Text="0:00"
                                                   FontSize="8" Width="26" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="TxtLauncherMiniDuration" DockPanel.Dock="Right" Text="0:00"
                                                   FontSize="8" Width="26" TextAlignment="Right" VerticalAlignment="Center"
                                                   Margin="4,0,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Grid x:Name="LauncherMiniSeekHit" Height="14" Background="Transparent" Cursor="Hand"
                                              VerticalAlignment="Center"
                                              PreviewMouseLeftButtonDown="LauncherMiniSeek_PreviewMouseLeftButtonDown"
                                              PreviewMouseMove="LauncherMiniSeek_PreviewMouseMove"
                                              PreviewMouseLeftButtonUp="LauncherMiniSeek_PreviewMouseLeftButtonUp"
                                              LostMouseCapture="LauncherMiniSeek_LostMouseCapture">
                                            <Slider x:Name="SldLauncherMiniSeek" Style="{StaticResource LauncherSeekSlider}"
                                                    IsHitTestVisible="False" Focusable="False" IsTabStop="False"/>
                                        </Grid>
                                    </DockPanel>
                                    <Border x:Name="LauncherMiniMarqueeClip" Grid.Row="1" Height="16"
                                            ClipToBounds="True" Margin="0,1,0,2" VerticalAlignment="Center"
                                            Cursor="Hand" Background="Transparent"
                                            Tag="Open Make Mods music"
                                            MouseLeftButtonUp="LauncherMiniMarquee_Click">
                                        <Canvas x:Name="LauncherMiniMarqueeCanvas" Height="16">
                                            <TextBlock x:Name="TxtLauncherMiniTrack" Text="No track" FontSize="11"
                                                       TextWrapping="NoWrap"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </Canvas>
                                    </Border>
                                    <DockPanel Grid.Row="2" LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnLauncherMiniPrev" Content="&#xE892;" Tag="Previous"
                                                    Style="{StaticResource LauncherPlayerBtn}" Click="BtnLauncherMiniPrev_Click"/>
                                            <Button x:Name="BtnLauncherMiniPlay" Content="&#xE768;" Tag="Play or pause"
                                                    Style="{StaticResource LauncherPlayerBtn}" Click="BtnLauncherMiniPlay_Click"/>
                                            <Button x:Name="BtnLauncherMiniNext" Content="&#xE893;" Tag="Next"
                                                    Style="{StaticResource LauncherPlayerBtn}" Click="BtnLauncherMiniNext_Click"/>
                                            <Button x:Name="BtnLauncherMiniLoop" Content="&#xE8EE;" Tag="Loop the playlist"
                                                    Style="{StaticResource LauncherPlayerBtn}" Margin="0"
                                                    Click="BtnLauncherMiniLoop_Click"/>
                                        </StackPanel>
                                        <Grid DockPanel.Dock="Right" VerticalAlignment="Center" Margin="4,0,0,0">
                                            <Button x:Name="BtnLauncherMiniVolume" Content="&#xE767;" Tag="Volume"
                                                    Style="{StaticResource LauncherPlayerBtn}" Margin="0"
                                                    Click="BtnLauncherMiniVolume_Click"/>
                                            <Popup x:Name="PopLauncherVolume" PlacementTarget="{Binding ElementName=BtnLauncherMiniVolume}"
                                                   Placement="Top" StaysOpen="False" AllowsTransparency="True"
                                                   HorizontalOffset="-6" VerticalOffset="-4">
                                                <Border Background="{DynamicResource CardBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                        CornerRadius="8" Padding="8,10" Margin="0,0,0,4">
                                                    <Slider x:Name="SldLauncherMiniVolume" Style="{StaticResource LauncherVolumeSlider}"
                                                            Value="0.85" Tag="Volume"
                                                            ValueChanged="SldLauncherMiniVolume_ValueChanged"/>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        <ComboBox x:Name="CmbLauncherMiniSongs" DockPanel.Dock="Right"
                                                  Style="{StaticResource LauncherSongPick}"
                                                  Width="18" Height="18" FontSize="11" Padding="0"
                                                  Margin="4,0,0,0" Tag="Pick a song"
                                                  VerticalAlignment="Center"
                                                  IsTextSearchEnabled="True"
                                                  SelectionChanged="CmbLauncherMiniSongs_SelectionChanged">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayLabel}" FontSize="11"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DockPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        <Button Grid.Row="1" Style="{StaticResource SmashTile}" Background="#FF6B2D8B"
                                Click="BtnManageMods_Click" Tag="Turn installed mods on or off.">
                            <StackPanel>
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Manage Mods" FontSize="18"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnPlay" Grid.Row="2" Style="{StaticResource SmashTile}"
                                Background="#FFE23D4A" Click="BtnPlay_Click" Tag="Launch Super Smash Flash 2.">
                            <StackPanel>
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtPlayLabel" Text="Play" FontSize="20"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Style="{StaticResource SmashTile}" Background="#FF1F8A4C"
                                Click="BtnDownloadMods_Click" Tag="Browse and install mods.">
                            <StackPanel>
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Download Mods" FontSize="22"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="1" Style="{StaticResource SmashTile}" Background="#FFE85D04"
                                Click="BtnMakeMods_Click" Tag="Create events, costumes, music, stages, and characters.">
                            <StackPanel>
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Make Mods" FontSize="22"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <Grid Grid.Row="1" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource SmashTile}" Background="#FFE23D4A"
                            Click="BtnConfigure_Click" Tag="Choose how the game starts.">
                        <StackPanel>
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Configure" FontSize="16"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <UniformGrid Grid.Column="1" Columns="2">
                        <Button Style="{StaticResource SmashTile}" Background="#FFC4920E" Click="BtnOpenDocs_Click"
                                Tag="Open the wiki.">
                            <StackPanel>
                                <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Docs" FontSize="15"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SmashTile}" Background="#FF3D4A5C" Click="BtnDebug_Click"
                                Tag="Open the editor and the debug stream.">
                            <StackPanel>
                                <TextBlock Text="&#xE98F;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Debug" FontSize="15"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Grid>
            <DockPanel x:Name="PageHost" Visibility="Collapsed" Background="#99000000">
                <Border x:Name="SectionBar" DockPanel.Dock="Top" Padding="12,8"
                        Background="#FFE85D04">
                    <StackPanel x:Name="Breadcrumb" Orientation="Horizontal"/>
                </Border>
                <ContentControl x:Name="PageContent" Margin="4"/>
            </DockPanel>
        </Grid>

        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <DockPanel>
                <ProgressBar x:Name="Progress" DockPanel.Dock="Top" Height="3"
                             Minimum="0" Maximum="1" Value="0" Visibility="Collapsed"
                             Foreground="{DynamicResource AccentBrush}" Background="#33FFFFFF"/>
                <TextBlock x:Name="TxtStatusDetail" Visibility="Collapsed" Width="0" DockPanel.Dock="Right"/>
                <TextBlock x:Name="TxtStatus" Text=""
                           FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Margin="10,0,10,0" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Grid.RowSpan="2" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource SidebarOutlineBrush}" BorderThickness="1" ClipToBounds="True">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Bottom" Margin="2,0,2,6">
                    <TextBlock x:Name="TxtVersion" Text="" FontSize="9"
                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtSidebarClock"
                               Text="00:00" FontSize="9"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,1,0,0"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Margin="0,8,0,0">
                    <Button x:Name="BtnRailMusic" Visibility="Collapsed" Tag="Open the music player."
                            Style="{StaticResource SmashRailBtn}" Click="BtnRailMusic_Click">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="18" Height="16" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtRailMusicIcon" Text="&#xE189;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Canvas x:Name="RailMusicViz" Width="18" Height="16" Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock x:Name="LblRailMusic" Text="Music" Margin="8,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Popup x:Name="MiniPlayerPopup" Placement="Left" PlacementTarget="{Binding ElementName=BtnRailMusic}"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="MiniPlayerPopup_Closed">
                        <Border x:Name="MiniPlayerPopupHost" Width="210" Padding="4" CornerRadius="8"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                    </Popup>
                    <Button Tag="News and updates." Style="{StaticResource SmashRailBtn}" Click="BtnNews_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="18" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblRailNews" Text="News" Margin="8,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="Settings for the mod manager." Style="{StaticResource SmashRailBtn}" Click="BtnSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="18" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblRailSettings" Text="Settings" Margin="8,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="Credits." Style="{StaticResource SmashRailBtn}" Click="BtnCredits_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="18" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblRailCredits" Text="Credits" Margin="8,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="Open the Discord." Style="{StaticResource SmashRailBtn}" Click="BtnDiscord_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16">
                                <Path Data="{StaticResource DiscordMarkGeometry}" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Viewbox>
                            <TextBlock x:Name="LblRailDiscord" Text="Discord" Margin="10,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="Buy a coffee." Style="{StaticResource SmashRailBtn}" Click="BtnSupport_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEC32;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="18" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblRailSupport" Text="Support" Margin="8,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnJpexs" Tag="Open JPEXS." Style="{StaticResource SmashRailBtn}" Click="BtnJpexs_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16">
                                <Path Data="{StaticResource FfdecMarkGeometry}" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Viewbox>
                            <TextBlock x:Name="LblRailJpexs" Text="JPEXS" Margin="10,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="Open the log." Style="{StaticResource SmashRailBtn}" Click="LinkOpenLog_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="18" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblRailLog" Text="Open log" Margin="8,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnRailExpand" Tag="Show names on the sidebar." Style="{StaticResource SmashRailBtn}" Click="BtnRailExpand_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="IcoRailExpand" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="18" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblRailExpand" Text="Expand" Margin="8,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <Canvas x:Name="LogoBounce" Grid.Column="0" Grid.RowSpan="2" Visibility="Collapsed"
                Background="Transparent" IsHitTestVisible="False" Panel.ZIndex="8">
            <Image x:Name="ImgBounceLogo" Width="84" Height="84" Stretch="Uniform" IsHitTestVisible="False">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="LogoShift"/>
                </Image.RenderTransform>
            </Image>
        </Canvas>
        </Grid>
        <Grid x:Name="BusyOverlay" Visibility="Collapsed" Background="#CC101018" Panel.ZIndex="50">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE1CD;" FontFamily="Segoe MDL2 Assets" FontSize="42"
                           Foreground="White" HorizontalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform x:Name="BusySpin"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="TxtBusy" Text="Working…" Margin="0,14,0,0"
                           Foreground="White" FontSize="16" HorizontalAlignment="Center"/>
                <ProgressBar x:Name="BusyProgress" Width="280" Height="8" Margin="0,12,0,0"
                             Minimum="0" Maximum="1" Value="0"
                             Foreground="{DynamicResource AccentBrush}" Background="#33FFFFFF"/>
                <Button x:Name="BtnBusyCancel" Content="Cancel" Visibility="Collapsed" HorizontalAlignment="Center"
                        Margin="0,14,0,0" Padding="16,6" Style="{StaticResource LauncherGhost}"
                        Click="BtnBusyCancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
