<Window x:Class="SSF2ModManager.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:SSF2ModManager.Services"
        Title="{x:Static svc:AppInfo.ProductName}"
        Width="560" Height="540"
        MinWidth="500" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <Style x:Key="LauncherPrimary" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="LauncherGhost" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="HomeView">
        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Banner -->
        <Border Grid.Row="0" Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Image Source="/SSF2M.png" Stretch="UniformToFill" Opacity="0.85"/>
                <Border Background="#66000000"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="10,8,0,0">
                    <Button Click="BtnDiscord_Click" Cursor="Hand" ToolTip="Discord"
                            FontSize="11" Padding="8,3" Margin="0,0,4,0" BorderThickness="0"
                            Foreground="{DynamicResource OnPrimaryBrush}"
                            Background="{DynamicResource PrimaryBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                <Path Data="{StaticResource DiscordMarkGeometry}" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Viewbox>
                            <TextBlock Text="Discord" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="✉ Feedback" Click="BtnFeedback_Click" Cursor="Hand"
                            FontSize="11" Padding="8,3" Margin="0,0,4,0" BorderThickness="0"
                            Foreground="{DynamicResource OnAccentBrush}"
                            Background="{DynamicResource AccentBrush}"/>
                    <Button Content="☕ Support" Click="BtnSupport_Click" Cursor="Hand"
                            FontSize="11" Padding="8,3" Foreground="White"
                            Background="#FFE04E4B" BorderThickness="0"/>
                </StackPanel>
                <TextBlock Text="{x:Static svc:AppInfo.ProductName}" FontSize="16" FontWeight="Bold"
                           Foreground="White" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="16,0,16,12"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,14,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Install folder -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="SSF2 Shell folder" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtVersion" Grid.Column="1" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,6"/>
                <TextBox x:Name="TxtInstallFolder" Grid.Row="1" Style="{StaticResource ModernTextBox}"
                         IsReadOnly="True" VerticalContentAlignment="Center"/>
                <Button Grid.Row="1" Grid.Column="1" Content="Change" Style="{StaticResource LauncherGhost}"
                        Margin="8,0,0,0" Padding="14,8" Click="BtnChangeFolder_Click"/>
            </Grid>

            <!-- Status + progress -->
            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="TxtStatusDetail" Text="" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,6"/>
                <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="1" Value="0"
                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource CardBrush}"/>
            </StackPanel>

            <!-- Primary actions -->
            <UniformGrid Grid.Row="2" Columns="3" Margin="0,16,0,0">
                <Button Content="Check for updates" Style="{StaticResource LauncherPrimary}"
                        Margin="0,0,6,0" Click="BtnCheckUpdates_Click"/>
                <Button x:Name="BtnPlay" Content="Play" Style="{StaticResource LauncherPrimary}"
                        Margin="3,0,3,0" Click="BtnPlay_Click"/>
                <Button Content="Configure" Style="{StaticResource LauncherPrimary}"
                        Margin="6,0,0,0" Click="BtnConfigure_Click"/>
            </UniformGrid>

            <!-- Secondary actions: two rows so labels are not clipped in a 5-column grid -->
            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <UniformGrid Columns="3" Margin="0,0,0,8">
                    <Button Content="Debug" Style="{StaticResource LauncherGhost}"
                            Margin="0,0,4,0" Click="BtnDebug_Click"/>
                    <Button Content="Make Mods" Style="{StaticResource LauncherGhost}"
                            Margin="2,0,2,0" Click="BtnMakeMods_Click"/>
                    <Button Content="Manage Mods" Style="{StaticResource LauncherGhost}"
                            Margin="4,0,0,0" Click="BtnManageMods_Click"/>
                </UniformGrid>
                <UniformGrid Columns="2">
                    <Button Content="Download Mods" Style="{StaticResource LauncherGhost}"
                            Margin="0,0,4,0" Click="BtnDownloadMods_Click"/>
                    <Button Content="Open Docs" Style="{StaticResource LauncherGhost}"
                            Margin="4,0,0,0" Click="BtnOpenDocs_Click"/>
                </UniformGrid>
            </StackPanel>

            <!-- Footer -->
            <Grid Grid.Row="5" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Settings" Style="{StaticResource LauncherGhost}" Padding="10,6"
                            Margin="0,0,6,0" Click="BtnSettings_Click"/>
                    <Button Content="Credits" Style="{StaticResource LauncherGhost}" Padding="10,6"
                            Margin="0,0,6,0" Click="BtnCredits_Click"/>
                    <Button Content="News" Style="{StaticResource LauncherGhost}" Padding="10,6"
                            Click="BtnNews_Click"/>
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Bottom">
                    <Hyperlink Click="LinkOpenLog_Click" Foreground="{DynamicResource AccentBrush}">Open log</Hyperlink>
                </TextBlock>
            </Grid>
        </Grid>
        </Grid>
        <DockPanel x:Name="PageHost" Visibility="Collapsed">
            <Border DockPanel.Dock="Top" Padding="12,10"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel x:Name="Breadcrumb" Orientation="Horizontal"/>
            </Border>
            <ContentControl x:Name="PageContent" Margin="4"/>
        </DockPanel>
        <Grid x:Name="BusyOverlay" Visibility="Collapsed" Background="#CC101018" Panel.ZIndex="50">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE1CD;" FontFamily="Segoe MDL2 Assets" FontSize="42"
                           Foreground="White" HorizontalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform x:Name="BusySpin"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="TxtBusy" Text="Working…" Margin="0,14,0,0"
                           Foreground="White" FontSize="16" HorizontalAlignment="Center"/>
                <ProgressBar x:Name="BusyProgress" Width="280" Height="8" Margin="0,12,0,0"
                             Minimum="0" Maximum="1" Value="0"
                             Foreground="{DynamicResource AccentBrush}" Background="#33FFFFFF"/>
                <Button x:Name="BtnBusyCancel" Content="Cancel" Visibility="Collapsed" HorizontalAlignment="Center"
                        Margin="0,14,0,0" Padding="16,6" Style="{StaticResource LauncherGhost}"
                        Click="BtnBusyCancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
