<Window x:Class="SSF2ModManager.Views.MakeModsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Make Mods" Width="640" Height="640"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="Transparent">
    <Window.Resources>
        <Style x:Key="MakeTile" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="6" Opacity="0.85">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0">
            <Button x:Name="BtnBack" DockPanel.Dock="Left" Content="Back" Style="{StaticResource ModernButton}"
                    Padding="8,4" Margin="0,0,8,4" Click="BtnBack_Click" Visibility="Collapsed"/>
            <TextBlock x:Name="TxtTitle" Text="" FontSize="1" Visibility="Collapsed"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <UniformGrid x:Name="PanelHome" Columns="3">
                    <Button Style="{StaticResource MakeTile}" Background="#FFE85D04" Foreground="White" Margin="4" Click="BtnEvents_Click" Tag="Make and compile events.">
                        <StackPanel Margin="8">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Events" FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MakeTile}" Background="#FFD35400" Foreground="White" Margin="4" Click="BtnCostumeSection_Click" Tag="Open the palette maker for one character.">
                        <StackPanel Margin="8">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Palette maker" FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MakeTile}" Background="#FFF07A1A" Foreground="White" Margin="4" Click="BtnMusic_Click" Tag="Edit stage playlists and your jukebox.">
                        <StackPanel Margin="8">
                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Music" FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MakeTile}" Background="#FFC44E08" Foreground="White" Margin="4" Click="BtnIntros_Click" Tag="Edit character intros.">
                        <StackPanel Margin="8">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Intros" FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MakeTile}" Background="#FFB84700" Foreground="White" Margin="4" Click="BtnStage_Click" Tag="Clone or import a stage.">
                        <StackPanel Margin="8">
                            <TextBlock Text="&#xE809;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Stage" FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MakeTile}" Background="#FFCC5500" Foreground="White" Margin="4" Click="BtnCharacter_Click" Tag="Clone or import a character.">
                        <StackPanel Margin="8">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Character" FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MakeTile}" Background="#FFE07020" Foreground="White" Margin="4" Click="BtnAltsSection_Click" Tag="Add a voice alt.">
                        <StackPanel Margin="8">
                            <TextBlock Text="&#xE8B8;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Character Alts" FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MakeTile}" Background="#FFA63D00" Foreground="White" Margin="4" Click="BtnPackage_Click" Tag="Package a mod for sharing.">
                        <StackPanel Margin="8">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Package mods" FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MakeTile}" Background="#FF8C3A00" Foreground="White" Margin="4" Click="BtnN2f_Click" Tag="Decompile, compile, and press SWFs.">
                        <StackPanel Margin="8">
                            <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Modding Tools" FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
            </UniformGrid>
            <ScrollViewer x:Name="FormScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>

                <Grid x:Name="PanelMusic" Visibility="Collapsed">
                    <UniformGrid x:Name="MusicMenu" Columns="3">
                        <Button Style="{StaticResource MakeTile}" Background="#FFE85D04" Click="BtnOpenJukebox_Click" Tag="Launch the in-game jukebox.">
                            <StackPanel Margin="4">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="Open in game My Jukebox" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MakeTile}" Background="#FFD35400" Click="BtnMusicStage_Click" Tag="Add and remove songs on a stage.">
                            <StackPanel Margin="4">
                                <TextBlock Text="&#xE809;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="Manage stage playlists" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MakeTile}" Background="#FFF07A1A" Click="BtnMusicSeries_Click" Tag="Playlists grouped as a series.">
                            <StackPanel Margin="4">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="Manage series playlists" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MakeTile}" Background="#FFC44E08" Click="BtnMusicCustom_Click" Tag="Your own playlists.">
                            <StackPanel Margin="4">
                                <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="Manage custom playlists" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MakeTile}" Background="#FFB84700" Click="BtnMusicUpload_Click" Tag="Add an MP3 as a new song.">
                            <StackPanel Margin="4">
                                <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="Upload songs" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MakeTile}" Background="#FF8C3A00" Click="BtnMusicNow_Click" Tag="Choose what the mod manager player plays.">
                            <StackPanel Margin="4">
                                <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="Miniplayer" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                    <StackPanel x:Name="MusicStagePage" Visibility="Collapsed">
                        <Button Content="Back" HorizontalAlignment="Left" Padding="8,4" Margin="0,0,0,6" Click="BtnMusicMenu_Click"/>
                        <TextBlock Text="Stage playlist" FontSize="14" Foreground="White" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbMusicStage" Margin="0,0,0,6" SelectionChanged="CmbMusicStage_SelectionChanged"/>
                        <ListBox x:Name="LstStageTracks" Height="90" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbStageAddSong" DisplayMemberPath="DisplayLabel" Margin="0,0,0,6"/>
                        <WrapPanel>
                            <Button Content="Add" Margin="0,0,6,6" Padding="10,4" Click="BtnStageAdd_Click"/>
                            <Button Content="Remove" Margin="0,0,6,6" Padding="10,4" Click="BtnStageRemove_Click"/>
                            <Button Content="Save" Margin="0,0,6,6" Padding="10,4" Click="BtnStageSave_Click"/>
                            <Button Content="Play here" Margin="0,0,6,6" Padding="10,4" Click="BtnStagePlay_Click"/>
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel x:Name="MusicListPage" Visibility="Collapsed">
                        <Button Content="Back" HorizontalAlignment="Left" Padding="8,4" Margin="0,0,0,6" Click="BtnMusicMenu_Click"/>
                        <TextBlock x:Name="TxtMusicListTitle" Text="Playlists" FontSize="14" Foreground="White" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbUserPlaylist" Margin="0,0,0,6" SelectionChanged="CmbUserPlaylist_SelectionChanged"/>
                        <ListBox x:Name="LstUserTracks" Height="90" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbUserAddSong" DisplayMemberPath="DisplayLabel" Margin="0,0,0,6"/>
                        <WrapPanel>
                            <Button Content="New" Margin="0,0,6,6" Padding="10,4" Click="BtnUserNew_Click"/>
                            <Button Content="Add" Margin="0,0,6,6" Padding="10,4" Click="BtnUserAdd_Click"/>
                            <Button Content="Remove" Margin="0,0,6,6" Padding="10,4" Click="BtnUserRemove_Click"/>
                            <Button Content="Delete" Margin="0,0,6,6" Padding="10,4" Click="BtnUserDelete_Click"/>
                            <Button Content="Play here" Margin="0,0,6,6" Padding="10,4" Click="BtnUserPlay_Click"/>
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel x:Name="MusicUploadPage" Visibility="Collapsed">
                        <Button Content="Back" HorizontalAlignment="Left" Padding="8,4" Margin="0,0,0,6" Click="BtnMusicMenu_Click"/>
                        <TextBlock Text="Upload a song" FontSize="14" Foreground="White" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Padding="8,4" Click="BtnUploadBrowse_Click"/>
                            <TextBox x:Name="TxtUploadFile" IsReadOnly="True"/>
                        </DockPanel>
                        <TextBox x:Name="TxtUploadId" Margin="0,0,0,6" ToolTip="Track id"/>
                        <TextBox x:Name="TxtUploadName" Margin="0,0,0,6" ToolTip="Song name"/>
                        <TextBox x:Name="TxtUploadArtist" Margin="0,0,0,6" ToolTip="Artist"/>
                        <Button Content="Upload" HorizontalAlignment="Left" Padding="10,4" Click="BtnUploadSong_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="MusicNowPage" Visibility="Collapsed">
                        <Button Content="Back" HorizontalAlignment="Left" Padding="8,4" Margin="0,0,0,6" Click="BtnMusicMenu_Click"/>
                        <TextBlock Text="Miniplayer" FontSize="14" Foreground="White" Margin="0,0,0,6"/>
                        <TextBlock Text="Song" Foreground="White" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbNowSong" DisplayMemberPath="DisplayLabel" Margin="0,0,0,6"/>
                        <Button Content="Play this song" HorizontalAlignment="Left" Padding="10,4" Margin="0,0,0,10" Click="BtnNowSong_Click"/>
                        <TextBlock Text="Playlist" Foreground="White" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbNowPlaylist" Margin="0,0,0,6"/>
                        <Button Content="Play this playlist" HorizontalAlignment="Left" Padding="10,4" Click="BtnNowPlaylist_Click"/>
                    </StackPanel>
                </Grid>

                <UniformGrid x:Name="PanelEvents" Columns="2" Visibility="Collapsed">
                    <Button Style="{StaticResource MakeTile}" Background="#FFE85D04" Click="BtnNewEvent_Click" Tag="Clone an event pack.">
                        <StackPanel Margin="8">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock Text="Make a new event" FontSize="15" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MakeTile}" Background="#FFD35400" Click="BtnCompileEvent_Click" Tag="Compile an event pack.">
                        <StackPanel Margin="8">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock Text="Compile an event" FontSize="15" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <Grid x:Name="PanelNewEvent" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Start" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="Clone from" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbEventSource" DisplayMemberPath="Label" Margin="0,0,0,8"
                                  SelectionChanged="CmbEventSource_SelectionChanged"/>
                        <TextBlock Text="Name" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtEventName" Margin="0,0,0,8" TextChanged="TxtEventName_TextChanged"/>
                        <TextBlock Text="Description" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtEventDesc" Margin="0,0,0,8" AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>
                        <TextBlock Text="Preview" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button Content="Change preview" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,4" Click="BtnEventPreview_Click"/>
                            <Image x:Name="ImgEventPreview" Height="72" Stretch="Uniform" HorizontalAlignment="Left"/>
                        </DockPanel>
                        <TextBlock Text="Match" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,14,0,6"/>
                        <TextBlock Text="Stage" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbEventStage" DisplayMemberPath="Label" Margin="0,0,0,8"/>
                        <TextBlock Text="Stage background" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbEventStageBg" DisplayMemberPath="Label" Margin="0,0,0,4"/>
                        <TextBlock Text="The match uses the stage above. This pick is that stage's camera background behind it. Stage picture keeps the match stage's own picture."
                                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Music" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="BtnEventMusicPreview" Content="Preview" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,4"
                                    Click="BtnEventMusicPreview_Click"/>
                            <ComboBox x:Name="CmbEventMusic" DisplayMemberPath="Label"/>
                        </DockPanel>
                        <WrapPanel Margin="0,0,0,4">
                            <CheckBox x:Name="ChkEventStocks" Content="Stocks" Margin="0,0,8,4" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox x:Name="TxtEventLives" Width="48" Margin="0,0,16,4"/>
                            <CheckBox x:Name="ChkEventTime" Content="Minutes" Margin="0,0,8,4" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox x:Name="TxtEventMinutes" Width="48" Margin="0,0,16,4"/>
                            <CheckBox x:Name="ChkEventHazards" Content="Hazards" Margin="0,0,12,4" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <CheckBox x:Name="ChkEventTeam" Content="Team damage" Margin="0,0,12,4" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </WrapPanel>

                        <TextBlock Text="Fighters" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,14,0,4"/>
                        <TextBlock Text="Each row is the cloned fighter, costume, human, level, and stocks. The rest of that event stays in the script."
                                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <StackPanel x:Name="EventFighterHost" Margin="0,0,0,4"/>
                        <CheckBox x:Name="ChkEventChoose" Content="Player chooses a character" Margin="0,8,0,10"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="BtnCreateEvent" Content="Create" Style="{StaticResource AccentButton}" Padding="14,8"
                                    Click="BtnCreateEvent_Click"/>
                            <Button x:Name="BtnCreateTestEvent" Content="Create and test" Style="{StaticResource AccentButton}" Padding="14,8"
                                    Margin="8,0,0,0" Click="BtnCreateTestEvent_Click"/>
                            <Button x:Name="BtnSaveEventPack" Content="Save and compile" Style="{StaticResource AccentButton}" Padding="14,8"
                                    Margin="8,0,0,0" Visibility="Collapsed" Click="BtnSaveEventPack_Click"/>
                            <Button x:Name="BtnTestEvent" Content="Compile and test" Style="{StaticResource AccentButton}" Padding="14,8"
                                    Margin="8,0,0,0" Visibility="Collapsed" Click="BtnTestEvent_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <Border x:Name="EventLoadOverlay" Visibility="Collapsed" Background="#E6101014" CornerRadius="8">
                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,36,0,0">
                            <ProgressBar IsIndeterminate="True" Width="180" Height="8"/>
                            <TextBlock Text="Loading event…" Margin="0,12,0,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel x:Name="PanelCompile" Visibility="Collapsed">
                    <TextBlock Text="Event pack" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbCompilePack" DisplayMemberPath="Label" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Compile" Style="{StaticResource AccentButton}" Padding="14,8"
                                HorizontalAlignment="Left" Click="BtnRunCompile_Click"/>
                        <Button Content="Compile and test" Style="{StaticResource AccentButton}" Padding="14,8"
                                Margin="8,0,0,0" Click="BtnCompileTest_Click"/>
                    </StackPanel>
                </StackPanel>

                <UniformGrid x:Name="PanelStage" Columns="4" Visibility="Collapsed">
                    <Button Style="{StaticResource MakeTile}" Background="#FFE85D04" Click="BtnMakeStage_Click" Tag="Clone a stage.">
                        <StackPanel Margin="8">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock Text="Clone a stage" FontSize="15" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MakeTile}" Background="#FFD35400" Click="BtnImportStage_Click" Tag="Import a stage file.">
                        <StackPanel Margin="8">
                            <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock Text="Import a stage" FontSize="15" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MakeTile}" Background="#FFF07A1A" Click="BtnOpenStageEditor_Click" Tag="Open the stage select editor.">
                        <StackPanel Margin="8">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock Text="Stage select" FontSize="15" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MakeTile}" Background="#FFC0392B" Click="BtnStageBackground_Click" Tag="Upload a picture or video as a stage background.">
                        <StackPanel Margin="8">
                            <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock Text="Create a stage background" FontSize="15" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MakeTile}" Background="#FF8E44AD" Click="BtnStageAsset_Click" Tag="Export a stage's pictures, edit them, and play that stage with the new pictures.">
                        <StackPanel Margin="8">
                            <TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock Text="Stage asset swap" FontSize="15" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <StackPanel x:Name="PanelMakeStage" Visibility="Collapsed">
                    <TextBlock Text="Stage to clone" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbStageSource" DisplayMemberPath="Label" Margin="0,0,0,8"/>
                    <TextBlock Text="Display name" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtStageDisplay" Margin="0,0,0,8" TextChanged="TxtStageDisplay_TextChanged"/>
                    <TextBlock Text="Stage name (linkages)" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtStageLinkage" Margin="0,0,0,8" TextChanged="TxtStageLinkage_TextChanged"/>
                    <TextBlock x:Name="TxtStageNameError" TextWrapping="Wrap" Margin="0,0,0,10"
                               Foreground="#E07070" Visibility="Collapsed"/>
                    <CheckBox x:Name="ChkStageKeepOldAssets" Content="Keep using clone's assets" Margin="0,0,0,10"
                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button x:Name="BtnMakeStageGo" Content="Clone stage" Style="{StaticResource AccentButton}" Padding="14,8"
                            HorizontalAlignment="Left" Click="BtnRunMakeStage_Click"/>
                    <CheckBox x:Name="ChkStageSkipFla" Content="Do not convert to FLA" Margin="0,8,0,0"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel x:Name="PanelStageBg" Visibility="Collapsed">
                    <TextBlock Text="Display name" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtStageBgName" Margin="0,0,0,8"/>
                    <TextBlock Text="Background file" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,8" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Padding="12,6"
                                Click="BtnBrowseStageBg_Click"/>
                        <TextBox x:Name="TxtStageBgFile" IsReadOnly="True"/>
                    </DockPanel>
                    <Image x:Name="ImgStageBg" Height="120" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <TextBlock Text="Default stage" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbStageBgDefault" DisplayMemberPath="Label" Margin="0,0,0,10"/>
                    <Button x:Name="BtnStageBgGo" Content="Create stage background" Style="{StaticResource AccentButton}" Padding="14,8"
                            HorizontalAlignment="Left" Click="BtnRunStageBackground_Click"/>
                </StackPanel>

                <StackPanel x:Name="PanelStageAsset" Visibility="Collapsed">
                    <TextBlock Text="Source stage" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbStageAssetSource" DisplayMemberPath="Label" Margin="0,0,0,8"
                              SelectionChanged="CmbStageAssetSource_SelectionChanged"/>
                    <TextBlock Text="Display name" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtStageAssetName" Margin="0,0,0,8"/>
                    <Button x:Name="BtnStageAssetGo" Content="Create" Style="{StaticResource AccentButton}" Padding="14,8"
                            HorizontalAlignment="Left" Click="BtnRunStageAsset_Click"/>
                    <TextBlock Text="Images" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                    <ListBox x:Name="LstStageAssets" Height="220" Margin="0,0,0,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="48" Height="36" Stretch="Uniform" Source="{Binding Image}" Margin="0,2,8,2"/>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="Open folder" Padding="14,8" HorizontalAlignment="Left" Click="BtnOpenStageAssetFolder_Click"/>
                </StackPanel>

                <StackPanel x:Name="PanelImportStage" Visibility="Collapsed">
                    <TextBlock Text="Stage files" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,8" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Padding="12,6"
                                Click="BtnBrowseStageFile_Click"/>
                        <TextBox x:Name="TxtImportStageFile" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="72" VerticalScrollBarVisibility="Auto"/>
                    </DockPanel>
                    <Button x:Name="BtnImportStageGo" Content="Import" Style="{StaticResource AccentButton}" Padding="14,8"
                            HorizontalAlignment="Left" Click="BtnRunImportStage_Click"/>
                    <CheckBox x:Name="ChkImportStageSkipFla" Content="Do not convert to FLA" Margin="0,8,0,0"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <UniformGrid x:Name="PanelCharacter" Columns="3" Visibility="Collapsed">
                    <Button Style="{StaticResource MakeTile}" Background="#FFE85D04" Click="BtnMakeCharacter_Click" Tag="Clone a character.">
                        <StackPanel Margin="8">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock Text="Clone a character" FontSize="15" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MakeTile}" Background="#FFD35400" Click="BtnImportCharacter_Click" Tag="Import a character file.">
                        <StackPanel Margin="8">
                            <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock Text="Import a character" FontSize="15" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MakeTile}" Background="#FFF07A1A" Click="BtnManageCss_Click" Tag="Open the character select editor.">
                        <StackPanel Margin="8">
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock Text="Character select" FontSize="15" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <StackPanel x:Name="PanelMakeCharacter" Visibility="Collapsed">
                    <TextBlock Text="Character to clone" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbCharSource" DisplayMemberPath="Label" Margin="0,0,0,8"/>
                    <TextBlock Text="Display name" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtCharDisplay" Margin="0,0,0,8" TextChanged="TxtCharDisplay_TextChanged"/>
                    <TextBlock Text="Character name (linkages)" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtCharLinkage" Margin="0,0,0,8" TextChanged="TxtCharLinkage_TextChanged"/>
                    <TextBlock x:Name="TxtCharNameError" TextWrapping="Wrap" Margin="0,0,0,10"
                               Foreground="#E07070" Visibility="Collapsed"/>
                    <CheckBox x:Name="ChkCharKeepOldAssets" Content="Keep using clone's assets" Margin="0,0,0,10"
                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button x:Name="BtnMakeCharacterGo" Content="Clone character" Style="{StaticResource AccentButton}" Padding="14,8"
                            HorizontalAlignment="Left" Click="BtnRunMakeCharacter_Click"/>
                    <CheckBox x:Name="ChkCharSkipFla" Content="Do not convert to FLA" Margin="0,8,0,0"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel x:Name="PanelImportCharacter" Visibility="Collapsed">
                    <TextBlock Text="Character files" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,8" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Padding="12,6"
                                Click="BtnBrowseCharacterFile_Click"/>
                        <TextBox x:Name="TxtImportCharFile" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="72" VerticalScrollBarVisibility="Auto"/>
                    </DockPanel>
                    <TextBlock x:Name="TxtImportCharError" TextWrapping="Wrap" Margin="0,0,0,10"
                               Foreground="#E07070" Visibility="Collapsed"/>
                    <Button x:Name="BtnImportCharGo" Content="Import" Style="{StaticResource AccentButton}" Padding="14,8"
                            HorizontalAlignment="Left" Click="BtnRunImportCharacter_Click"/>
                    <CheckBox x:Name="ChkImportCharSkipFla" Content="Do not convert to FLA" Margin="0,8,0,0"
                              IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel x:Name="PanelCostume" Visibility="Collapsed">
                    <TextBlock Text="Character" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbCostumeCharacter" Margin="0,0,0,10"/>
                    <Button Content="Open palette maker" Style="{StaticResource AccentButton}" Padding="14,8"
                            HorizontalAlignment="Left" Click="BtnCostume_Click"/>
                </StackPanel>

                <StackPanel x:Name="PanelAlts" Visibility="Collapsed">
                    <TextBlock Text="Install extracts the character's sounds and adds a voice alt. You can still edit later under Manage Mods → Alts."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="Character" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbAltCharacter" Margin="0,0,0,8"/>
                    <TextBlock Text="Alt name (optional)" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtAltName" Margin="0,0,0,8"/>
                    <TextBlock Text="Apply to" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="RadAltAll" Content="All costumes" IsChecked="True" Margin="0,0,16,0"
                                     Foreground="{DynamicResource TextPrimaryBrush}" Checked="RadAltScope_Changed"/>
                        <RadioButton x:Name="RadAltCostume" Content="Specific costume"
                                     Foreground="{DynamicResource TextPrimaryBrush}" Checked="RadAltScope_Changed"/>
                    </StackPanel>
                    <StackPanel x:Name="PanelAltCostumePick" Visibility="Collapsed" Margin="0,0,0,8">
                        <TextBlock Text="Costume index (−1 = base)" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Pick in game…" Padding="12,6" Margin="8,0,0,0"
                                    Click="BtnAltPickCostume_Click"/>
                            <TextBox x:Name="TxtAltCostume" Text="-1"/>
                        </DockPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                   Text="Opens Character Select with this character and the costume grid. The voice alt applies only when that costume is selected — usually a Color Vault / local costume, not every palette slot."/>
                    </StackPanel>
                    <Button Content="Install alt" Style="{StaticResource AccentButton}" Padding="14,8"
                            HorizontalAlignment="Left" Click="BtnAltInstall_Click"/>
                    <TextBlock x:Name="TxtAltWork" TextWrapping="Wrap" Margin="0,10,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel x:Name="PanelIntros" Visibility="Collapsed">
                    <TextBlock Text="Custom boot intros live in expansions/intros. Add converts a video to the same FLV the game already plays."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <ListBox x:Name="LstIntros" Height="180" Margin="0,0,0,8" DisplayMemberPath="Label"/>
                    <WrapPanel>
                        <Button Content="Add intro…" Style="{StaticResource AccentButton}" Padding="14,8" Margin="0,0,8,0"
                                Click="BtnAddMakeIntro_Click"/>
                        <Button Content="Remove intro" Style="{StaticResource ModernButton}" Padding="14,8"
                                Click="BtnRemoveMakeIntro_Click"/>
                    </WrapPanel>
                </StackPanel>

                <UniformGrid x:Name="PanelPackageHome" Columns="3" Visibility="Collapsed">
                    <Button Style="{StaticResource MakeTile}" Background="#FFE85D04" Click="BtnPackageEdit_Click" Tag="Edit a mod's info.">
                        <StackPanel Margin="8">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock Text="Edit mod info" FontSize="15" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MakeTile}" Background="#FFD35400" Click="BtnPackageZipSection_Click" Tag="Zip mods to share.">
                        <StackPanel Margin="8">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock Text="Package mods" FontSize="15" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MakeTile}" Background="#FFF07A1A" Click="BtnPackageInstall_Click" Tag="Install a mod archive.">
                        <StackPanel Margin="8">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock Text="Install archive" FontSize="15" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <StackPanel x:Name="PanelPackageZip" Visibility="Collapsed">
                    <TextBlock Text="Check the mods to put in one package. One mod keeps its own name. More than one asks for a pack name and description, then writes one .ssfe."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <ListBox x:Name="LstPackageZip" Height="220" Margin="0,0,0,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding Include, Mode=TwoWay}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="TxtPackageZipEmpty" Text="No local mods to package."
                               Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" Margin="0,0,0,8"/>
                    <Button Content="Package" Style="{StaticResource AccentButton}" Padding="14,8"
                            HorizontalAlignment="Left" Click="BtnPackageZip_Click"/>
                </StackPanel>

                <StackPanel x:Name="PanelPackageEdit" Visibility="Collapsed">
                    <TextBlock Text="The highlighted row is the info.json these fields write. Downloaded mods stay off this list."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <ComboBox x:Name="LstPackageMods" Margin="0,0,0,8"
                              DisplayMemberPath="Label"
                              SelectionChanged="LstPackageMods_SelectionChanged"/>
                    <TextBlock x:Name="TxtPackageEmpty" Text="No local mods to package."
                               Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" Margin="0,0,0,8"/>
                    <TextBlock Text="Name" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtPackageName" Margin="0,0,0,8"/>
                    <TextBlock Text="Creator" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtPackageCreator" Margin="0,0,0,8"/>
                    <TextBlock Text="Type" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbPackageType" Margin="0,0,0,8"/>
                    <TextBlock Text="Version" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtPackageVersion" Margin="0,0,0,8"/>
                    <TextBlock Text="Description" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtPackageDesc" Margin="0,0,0,8" AcceptsReturn="True" Height="72" TextWrapping="Wrap"/>
                    <TextBlock Text="Dependencies" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Type a GameBanana mod name and double-click a row. Enter also adds an id or a mods link."
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <WrapPanel x:Name="PnlPackageDeps" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtDepSearch" Margin="0,0,0,4" TextChanged="TxtDepSearch_TextChanged" KeyDown="TxtDepSearch_KeyDown"/>
                    <ListBox x:Name="LstDepHits" Height="120" Margin="0,0,0,10" DisplayMemberPath="Label"
                             MouseDoubleClick="LstDepHits_MouseDoubleClick"/>
                    <Button Content="Save info.json" Style="{StaticResource AccentButton}" Padding="14,8"
                            HorizontalAlignment="Left" Click="BtnPackageSave_Click"/>
                </StackPanel>

                <UniformGrid x:Name="PanelN2f" Columns="3" Visibility="Collapsed">
                    <Button Style="{StaticResource MakeTile}" Background="#FFE85D04" Click="BtnDecompileSection_Click" Tag="Convert a SWF to FLA.">
                        <StackPanel Margin="8">
                            <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock Text="Convert to FLA" FontSize="15" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MakeTile}" Background="#FFD35400" Click="BtnCompileFolder_Click" Tag="Compile a folder to SWF.">
                        <StackPanel Margin="8">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock Text="Compile folder" FontSize="15" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MakeTile}" Background="#FFF07A1A" Click="BtnPressor_Click" Tag="Compress or uncompress SWF files.">
                        <StackPanel Margin="8">
                            <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock Text="Pressor" FontSize="15" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <StackPanel x:Name="PanelPressor" Visibility="Collapsed">
                    <TextBlock Text="Uncompress turns .ssf into .swf. Compress turns .swf into .ssf. A name that already has a dash is written back to the parent folder. Create moddable build copies the game folder into Documents and sorts data."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkPressorGarbage" Content="Take care of garbage header" IsChecked="True"
                              Margin="0,0,0,10" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button Content="Uncompress files" Style="{StaticResource AccentButton}" Padding="16,12" Margin="0,0,0,8"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="BtnPressorUncompressFiles_Click"/>
                    <Button Content="Uncompress folder" Style="{StaticResource AccentButton}" Padding="16,12" Margin="0,0,0,8"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="BtnPressorUncompressFolder_Click"/>
                    <Button Content="Compress files" Style="{StaticResource AccentButton}" Padding="16,12" Margin="0,0,0,8"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="BtnPressorCompressFiles_Click"/>
                    <Button Content="Compress folder" Style="{StaticResource AccentButton}" Padding="16,12" Margin="0,0,0,8"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="BtnPressorCompressFolder_Click"/>
                    <Button Content="Create moddable build" Style="{StaticResource AccentButton}" Padding="16,12"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="BtnPressorModdable_Click"/>
                </StackPanel>

                <StackPanel x:Name="PanelDecompile" Visibility="Collapsed">
                    <TextBlock Text="Pick a data folder, then one file. A .ssf is opened as a SWF. Output goes to expansions/decompiled. The engine folder is decompiled there instead of into data/engine."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="Folder" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbDecompileFolder" Margin="0,0,0,8" SelectionChanged="CmbDecompileFolder_SelectionChanged"/>
                    <TextBlock Text="File" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbDecompileSwf" DisplayMemberPath="Label" Margin="0,0,0,10"/>
                    <Button Content="Convert to FLA" Style="{StaticResource AccentButton}" Padding="14,8"
                            HorizontalAlignment="Left" Click="BtnRunDecompile_Click"/>
                </StackPanel>

                <StackPanel x:Name="PanelCompileFolder" Visibility="Collapsed">
                    <TextBlock Text="engine2 is the decompiled engine. The other rows are mod src folders under expansions/mods. template is left out."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <ComboBox x:Name="CmbCompileFolder" DisplayMemberPath="Label" Margin="0,0,0,10"/>
                    <Button Content="Compile" Style="{StaticResource AccentButton}" Padding="14,8"
                            HorizontalAlignment="Left" Click="BtnRunCompileFolder_Click"/>
                </StackPanel>

                <TextBox x:Name="TxtLog" Margin="0,14,0,0" IsReadOnly="True" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="140"
                         FontFamily="Consolas" FontSize="12" Visibility="Collapsed"/>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
