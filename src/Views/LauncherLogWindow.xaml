<Window x:Class="SSF2ModManager.Views.LauncherLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log"
        Width="900" Height="600"
        MinWidth="640" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="#FF1A1A22"
        Foreground="#FFF2F2F6">
    <Window.Resources>
        <Style x:Key="LogButton" TargetType="Button">
            <Setter Property="Background" Value="#FF2A2A38"/>
            <Setter Property="Foreground" Value="#FFF2F2F6"/>
            <Setter Property="BorderBrush" Value="#FF4A4A60"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="14"/>
            <Setter Property="MinWidth" Value="14"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Margin="0,0,0,12" Background="#FF0E0E14" CornerRadius="8"
                BorderBrush="#FF2A2A38" BorderThickness="1" Padding="12,8">
            <DockPanel>
                <TextBlock x:Name="TxtProfiler" DockPanel.Dock="Top" FontFamily="Consolas" FontSize="14"
                           Foreground="#FFE8EAEF" Margin="0,0,0,4" Text="SSF2 has not connected"/>
                <TextBlock DockPanel.Dock="Top" FontFamily="Consolas" FontSize="11"
                           Foreground="#FF9AA0AE" Margin="0,0,0,6"
                           Text="frames   green  ≤34 ms   yellow  ≤68 ms   red  hitch      line   purple  private memory"/>
                <TextBlock x:Name="TxtSpike" DockPanel.Dock="Bottom" FontFamily="Consolas" FontSize="12"
                           Foreground="#FFC8C8D4" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <Slider x:Name="ProfilerScrub" DockPanel.Dock="Bottom" Minimum="0" Maximum="0"
                        IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10"
                        Margin="0,6,0,0" ValueChanged="ProfilerScrub_Changed"
                        Foreground="#FFC8C8D4" IsEnabled="False"/>
                <Canvas x:Name="ProfilerPlot" Height="64" ClipToBounds="True"
                        MouseLeftButtonDown="ProfilerPlot_MouseDown"/>
            </DockPanel>
        </Border>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="Refresh" Style="{StaticResource LogButton}" Click="BtnRefresh_Click"/>
                <Button Content="Copy all" Style="{StaticResource LogButton}" Click="BtnCopy_Click"/>
                <Button Content="Clear" Style="{StaticResource LogButton}" Margin="0" Click="BtnClear_Click"/>
            </WrapPanel>
            <WrapPanel VerticalAlignment="Center">
                <CheckBox x:Name="ChkDebug" Content="Debug" Margin="0,0,16,0" IsChecked="True"
                          Foreground="#FFF2F2F6" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <CheckBox x:Name="ChkManager" Content="Mod Manager" Margin="0,0,16,0" IsChecked="True"
                          Foreground="#FFF2F2F6" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <CheckBox x:Name="ChkGame" Content="SSF2" Margin="0,0,16,0" IsChecked="True"
                          Foreground="#FFF2F2F6" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <CheckBox x:Name="ChkSsf2ErrorsOnly" Content="SSF2 Errors only" IsChecked="False"
                          Foreground="#FFFF8A8A" Checked="ErrorsOnly_Changed" Unchecked="ErrorsOnly_Changed"
                          ToolTip="Show only SSF2 uncaught errors and stack traces"/>
                <CheckBox x:Name="ChkFollowGame" Content="Open and close with SSF2" Margin="16,0,0,0" IsChecked="False"
                          Foreground="#FFF2F2F6" Checked="Follow_Changed" Unchecked="Follow_Changed"
                          ToolTip="Open this log when SSF2 starts, and close it when SSF2 exits"/>
                <CheckBox x:Name="ChkLatestRun" Content="Only latest run" Margin="16,0,0,0" IsChecked="True"
                          Foreground="#FFF2F2F6" Checked="Filter_Changed" Unchecked="Filter_Changed"
                          ToolTip="Show the current SSF2 boot and the current Mod Manager start, so Copy all is one run"/>
            </WrapPanel>
        </DockPanel>
        <Border Background="#FF0E0E14" CornerRadius="8" Padding="0" BorderBrush="#FF2A2A38" BorderThickness="1">
            <RichTextBox x:Name="TxtLog"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         Background="Transparent"
                         Foreground="#FFC8C8D4"
                         BorderThickness="0"
                         Padding="12"
                         SelectionBrush="#FF4EA1FF"
                         SelectionTextBrush="#FFFFFFFF"
                         AcceptsReturn="True"
                         VerticalContentAlignment="Top"
                         SnapsToDevicePixels="True">
                <RichTextBox.Resources>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </RichTextBox.Resources>
            </RichTextBox>
        </Border>
    </DockPanel>
</Window>
