<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Midnight blue -->
  <Color x:Key="BackgroundColor">#FF001524</Color>
  <Color x:Key="CardColor">#FF002B36</Color>
  <Color x:Key="TextPrimaryColor">#FFEEFFFF</Color>
  <Color x:Key="TextSecondaryColor">#FF9BC0C7</Color>
  <Color x:Key="AccentColor">#FF4DB6AC</Color>
  <Color x:Key="PrimaryDarkColor">#FF3A9088</Color>
  <Color x:Key="OnAccentColor">#FF04221F</Color>
  <Color x:Key="OnPrimaryColor">#FF04221F</Color>

  <Color x:Key="BorderColor">#FF0A3A44</Color>

  <!-- Sidebar and surface keys so app areas update correctly -->
  <Color x:Key="SidebarColor">#FF001524</Color>
  <Color x:Key="SurfaceColor">#FF002B36</Color>

  <!-- Selection (used for highlights) -->
  <Color x:Key="SelectionBackgroundColor">#FF4DB6AC</Color>
  <Color x:Key="SelectionForegroundColor">#FF04221F</Color>

  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
  <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
  <SolidColorBrush x:Key="SidebarOutlineBrush" Color="White"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="{StaticResource SelectionBackgroundColor}"/>
  <SolidColorBrush x:Key="SelectionForegroundBrush" Color="{StaticResource SelectionForegroundColor}"/>
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
</ResourceDictionary>