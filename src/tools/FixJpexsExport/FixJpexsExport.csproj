<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FixJpexsExport</AssemblyName>
    <RootNamespace>FixJpexsExport</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Default build is framework-dependent. scripts\release\publish.ps1 publishes it self-contained, single-file. -->
    <OutputPath>$(MSBuildThisFileDirectory)..\..\..\SSF2 Mod Manager Release\runtime\shell-dev\tools\</OutputPath>
  </PropertyGroup>
</Project>
